FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /bin/uv
WORKDIR /opt/rxnscribe
COPY requirements-onnx.txt ./
RUN uv pip install --system --no-cache -r requirements-onnx.txt
COPY rxnscribe/ ./rxnscribe/
ENV PYTHONPATH=/opt/rxnscribe
ENV MPLCONFIGDIR=/tmp/matplotlib
# Bundles are mounted at runtime; never bake checkpoints into the image.
CMD ["python", "-c", "from rxnscribe import RxnScribeONNX; print('ONNX runtime ready; mount an exported model bundle')"]
